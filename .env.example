# Neon Postgres connection string (use the "pooled" connection string from Neon)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The single password used to unlock the dashboard
APP_PASSWORD="change-me-to-something-strong"

# A long random secret used to sign the auth cookie.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-hex-string"
